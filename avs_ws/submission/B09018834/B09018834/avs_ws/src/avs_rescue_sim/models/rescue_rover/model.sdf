<?xml version="1.0"?>
<sdf version="1.6">
  <model name="rescue_rover">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <pose>0 0 0.12 0 0 0</pose>
      <!-- Rearward battery/ballast keeps the rear caster loaded.  A centre of
           mass on the drive axle let the rover tip onto its front pusher,
           tilting the planar laser and corrupting localization/costmaps. -->
      <inertial><pose>-0.06 0 0 0 0 0</pose><mass>12.0</mass><inertia><ixx>0.12</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.20</iyy><iyz>0</iyz><izz>0.25</izz></inertia></inertial>
      <collision name="chassis_collision"><geometry><box><size>0.42 0.24 0.14</size></box></geometry><surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface></collision>
      <visual name="chassis_visual"><geometry><box><size>0.42 0.24 0.14</size></box></geometry><material><ambient>0.03 0.18 0.55 1</ambient><diffuse>0.05 0.28 0.82 1</diffuse></material></visual>
      <visual name="stripe_visual"><pose>0.04 0 0.075 0 0 0</pose><geometry><box><size>0.25 0.245 0.012</size></box></geometry><material><ambient>0.95 0.60 0.02 1</ambient><diffuse>1 0.72 0.02 1</diffuse></material></visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.12 0.085 -1.5708 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.003</iyy><iyz>0</iyz><izz>0.003</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.085</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0</slip1><slip2>0</slip2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.085</radius><length>0.045</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <!-- SDF expresses this joint axis in the rotated wheel-link frame.  The
         wheel link is rolled -90 deg about X, so local Z is the model's
         transverse Y axle (equivalent to axis 0 1 0 in the URDF joint). -->
    <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>80</effort><velocity>40</velocity></limit></axis></joint>

    <link name="right_wheel">
      <pose>0 -0.12 0.085 -1.5708 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.003</iyy><iyz>0</iyz><izz>0.003</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.085</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0</slip1><slip2>0</slip2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.085</radius><length>0.045</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
    </link>
    <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>80</effort><velocity>40</velocity></limit></axis></joint>

    <link name="rear_caster">
      <pose>-0.17 0 0.047 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.047</radius></sphere></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2><slip1>1</slip1><slip2>1</slip2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.047</radius></sphere></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
    </link>
    <joint name="rear_caster_joint" type="fixed"><parent>base_link</parent><child>rear_caster</child></joint>

    <link name="pusher">
      <inertial><pose>0.24 0 0.105 0 0 0</pose><mass>1.2</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.02</izz></inertia></inertial>
      <collision name="crossbar_collision"><pose>0.22 0 0.105 0 0 0</pose><geometry><box><size>0.14 0.28 0.10</size></box></geometry><surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface></collision>
      <visual name="crossbar_visual"><pose>0.22 0 0.105 0 0 0</pose><geometry><box><size>0.14 0.28 0.10</size></box></geometry><material><ambient>0.9 0.50 0.01 1</ambient><diffuse>1 0.68 0.02 1</diffuse></material></visual>
      <collision name="left_wing_collision"><pose>0.26 0.075 0.105 0 0 -0.45</pose><geometry><box><size>0.18 0.055 0.10</size></box></geometry></collision>
      <visual name="left_wing_visual"><pose>0.26 0.075 0.105 0 0 -0.45</pose><geometry><box><size>0.18 0.055 0.10</size></box></geometry><material><ambient>0.95 0.60 0.01 1</ambient><diffuse>1 0.75 0.02 1</diffuse></material></visual>
      <collision name="right_wing_collision"><pose>0.26 -0.075 0.105 0 0 0.45</pose><geometry><box><size>0.18 0.055 0.10</size></box></geometry></collision>
      <visual name="right_wing_visual"><pose>0.26 -0.075 0.105 0 0 0.45</pose><geometry><box><size>0.18 0.055 0.10</size></box></geometry><material><ambient>0.95 0.60 0.01 1</ambient><diffuse>1 0.75 0.02 1</diffuse></material></visual>
    </link>
    <joint name="pusher_joint" type="fixed"><parent>base_link</parent><child>pusher</child></joint>

    <link name="laser_link">
      <pose>0.08 0 0.23 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.055</radius><length>0.06</length></cylinder></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>
      <sensor name="lidar" type="ray"><always_on>true</always_on><visualize>false</visualize><update_rate>15</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.08</min><max>8.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise></ray><plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>laser_frame</frame_name></plugin></sensor>
    </link>
    <joint name="laser_joint" type="fixed"><parent>base_link</parent><child>laser_link</child></joint>

    <link name="camera_link">
      <pose>0.20 0 0.27 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name="visual"><geometry><box><size>0.06 0.09 0.06</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <sensor name="front_camera" type="camera"><always_on>true</always_on><visualize>false</visualize><update_rate>15</update_rate><camera><horizontal_fov>1.20</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.04</near><far>8.0</far></clip></camera><plugin name="camera_ros" filename="libgazebo_ros_camera.so"><camera_name>camera</camera_name><frame_name>camera_optical_frame</frame_name></plugin></sensor>
    </link>
    <joint name="camera_joint" type="revolute">
      <parent>base_link</parent><child>camera_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.95</lower><upper>1.95</upper><effort>2</effort><velocity>1.2</velocity></limit><dynamics><damping>0.1</damping></dynamics></axis>
    </joint>
    <plugin name="camera_pan" filename="libavs_camera_pan.so">
      <joint_name>camera_joint</joint_name><position_gain>5.0</position_gain>
      <max_velocity>1.2</max_velocity><max_torque>0.1</max_torque>
    </plugin>
    <plugin name="camera_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate><joint_name>camera_joint</joint_name>
    </plugin>

    <!-- Nav2 smooths velocity once. Apply its wheel targets directly here so
         a second acceleration integrator cannot delay an emergency stop. -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=cmd_vel_safe</remapping><remapping>odom:=odom</remapping></ros>
      <update_rate>60</update_rate><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.24</wheel_separation><wheel_diameter>0.17</wheel_diameter><max_wheel_torque>55</max_wheel_torque><max_wheel_acceleration>0.0</max_wheel_acceleration><command_topic>cmd_vel</command_topic><odometry_topic>odom</odometry_topic><odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame><publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </model>
</sdf>
