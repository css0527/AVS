Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 36; 40
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Alpha: 0.55
      Cell Size: 0.25
      Class: rviz_default_plugins/Grid
      Color: 120; 125; 130
      Enabled: true
      Name: Grid
      Plane: XY
    - Alpha: 0.85
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Occupancy Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: Rescue Rover
    - Class: rviz_default_plugins/LaserScan
      Color: 255; 50; 40
      Enabled: true
      Name: Laser Scan
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Value: /scan
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Core Hazard Markers
      Topic:
        Depth: 10
        Reliability Policy: Reliable
        Value: /hazards/core_markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Mission Route
      Topic:
        Depth: 10
        Reliability Policy: Reliable
        Value: /mission/planned_route
    - Class: rviz_default_plugins/Path
      Color: 20; 235; 80
      Enabled: true
      Name: Global Plan
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /plan
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Annotated Camera
      Topic:
        Depth: 2
        Reliability Policy: Reliable
        Value: /camera/annotated
  Enabled: true
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 85
      Target Frame: map
      X: 1.5
      Y: 1.5
Window Geometry:
  Height: 900
  Width: 1200
